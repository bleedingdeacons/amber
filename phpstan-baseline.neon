parameters:
	ignoreErrors:
		-
			message: '#^Method Amber\\Admin\\IntergroupMeetings\\IntergroupMeetingAdmin\:\:findTodaysIntergroupMeeting\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Admin/IntergroupMeetings/IntergroupMeetingAdmin.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 2
			path: src/Admin/IntergroupMeetings/IntergroupMeetingAdmin.php

		-
			message: '#^Property Amber\\Admin\\IntergroupMeetings\\IntergroupMeetingAdmin\:\:\$meetingRepository is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Admin/IntergroupMeetings/IntergroupMeetingAdmin.php

		-
			message: '#^Property Amber\\Admin\\IntergroupMeetings\\IntergroupMeetingAdmin\:\:\$positionFactory is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Admin/IntergroupMeetings/IntergroupMeetingAdmin.php

		-
			message: '#^Used constant DOING_AUTOSAVE not found\.$#'
			identifier: constant.notFound
			count: 1
			path: src/Admin/IntergroupMeetings/IntergroupMeetingAdmin.php

		-
			message: '#^Variable \$entries in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/Admin/IntergroupMeetings/IntergroupMeetingDashboard.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: src/Admin/IntergroupMeetings/ReportsAdmin.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: src/Admin/Members/AnonymousNameValidator.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 2
			path: src/Admin/Members/DirectoryDashboard.php

		-
			message: '#^Property Amber\\Admin\\Members\\DirectoryDashboard\:\:\$member_config is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Admin/Members/DirectoryDashboard.php

		-
			message: '#^Used constant DOING_AUTOSAVE not found\.$#'
			identifier: constant.notFound
			count: 1
			path: src/Admin/Members/MemberAdmin.php

		-
			message: '#^Strict comparison using \=\=\= between int\<4, max\> and 1 will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Admin/Positions/PositionAdmin.php

		-
			message: '#^Used constant DOING_AUTOSAVE not found\.$#'
			identifier: constant.notFound
			count: 1
			path: src/Admin/Positions/PositionAdmin.php

		-
			message: '#^Used function get_field not found\.$#'
			identifier: function.notFound
			count: 1
			path: src/Admin/Positions/PositionAdmin.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: src/Admin/Positions/PositionNameValidator.php

		-
			message: '#^Constant AMBER_PLUGIN_DIR not found\.$#'
			identifier: constant.notFound
			count: 1
			path: src/Core/HelpPage.php

		-
			message: '#^Call to static method logError\(\) on an unknown class Trumpet\\Plugin\.$#'
			identifier: class.notFound
			count: 1
			path: src/Managers/FrontPageManager.php

		-
			message: '#^Variable \$showHighlight might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: src/Managers/IntergroupManager.php

		-
			message: '#^Method Unity\\Positions\\Interfaces\\PositionView\:\:isArchivist\(\) invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Managers/PositionShortcodeRenderer.php

		-
			message: '#^Parameter \#1 \$text of function esc_html expects string, \(float\|int\) given\.$#'
			identifier: argument.type
			count: 1
			path: src/Managers/PositionShortcodeRenderer.php

		-
			message: '#^Parameter \#1 \$text of function esc_html expects string, int given\.$#'
			identifier: argument.type
			count: 2
			path: src/Managers/PositionShortcodeRenderer.php

		-
			message: '#^Used function get_field not found\.$#'
			identifier: function.notFound
			count: 1
			path: src/Managers/PositionShortcodeRenderer.php

		-
			message: '#^Used function get_field not found\.$#'
			identifier: function.notFound
			count: 1
			path: src/Managers/PostTitleSyncer.php
